	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5001/api/v1",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "tempToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "employeeId",
			"value": "",
			"type": "string"
		},
		{
			"key": "attendanceId",
			"value": "",
			"type": "string"
		},
		{
			"key": "leaveId",
			"value": "",
			"type": "string"
		},
		{
			"key": "leaveTypeId",
			"value": "",
