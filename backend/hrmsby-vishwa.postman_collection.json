		{
			"name": "6. Leave Management",
			"item": [
				{
					"name": "Apply for Leave",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.leaveId) {",
									"        pm.collectionVariables.set('leaveId', jsonData.data.leaveId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "leaveTypeId",
									"value": "{{leaveTypeId}}",
									"type": "text",
									"description": "Leave Type ID (get from Leave Type endpoints)"
								},
								{
									"key": "fromDate",
									"value": "2026-01-10",
									"type": "text",
									"description": "Format: YYYY-MM-DD"
								},
								{
									"key": "toDate",
									"value": "2026-01-12",
									"type": "text",
									"description": "Format: YYYY-MM-DD"
								},
								{
									"key": "reason",
									"value": "Not feeling well",
									"type": "text"
								},
								{
									"key": "attachment",
									"type": "file",
									"src": [],
									"description": "Optional: Medical certificate or document"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/leave/apply",
							"host": ["{{baseUrl}}"],
							"path": ["leave", "apply"]
						},
						"description": "Apply for leave. Requires leaveTypeId (get from Leave Type endpoints). Uses fromDate/toDate instead of startDate/endDate."
					}
				},
				{
					"name": "Get Leave Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/leave?status=PENDING&page=1&limit=30",
							"host": ["{{baseUrl}}"],
							"path": ["leave"],
