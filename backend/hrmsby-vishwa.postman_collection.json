									"disabled": true,
									"description": "Filter by start date"
								},
								{
									"key": "endDate",
									"value": "",
									"disabled": true,
									"description": "Filter by end date"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "30"
								}
							]
